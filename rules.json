{
    "rule1" : {
        "predicate" : "ALL",
        "filter": [
            {
                "field" : "from_address",
                "condition" : "contains",
                "value" : "tenmils.com" 
            },
            {
                "field" : "date_received",
                "condition" : "less_than",
                "value" : "2",
                "unit"  : "day(s)"
            }
        ],
        "actions":[
            {
                "name" : "move_message",
                "label" : "inbox"
            }, 
            {
                "name" : "mark_as_read"
            }
        ]
    }
}
